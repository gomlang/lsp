pub struct CreateFile {
    pub uri: string,
    pub options: Option[CreateFileOptions],
    pub annotation_id: Option[string],
}

impl CreateFile {
    pub fn from_json(value: json::Value) -> Result[CreateFile, RpcError] {
        let _ = members(value)?;
        if string_field(value, "kind")? != "create" {
            return Result::Err(invalid("unexpected resource operation kind"))
        }
        let options = match json::field(value, "options") {
            Some(value) => Option::Some(CreateFileOptions::from_json(value)?),
            None => Option::None,
        };
        let result = CreateFile {
            uri: string_field(value, "uri")?,
            options,
            annotation_id: workspace_string(value, "annotationId")?,
        };
        let _ = result.to_json()?;
        Result::Ok(result)
    }

    pub fn to_json(self: CreateFile) -> Result[json::Value, RpcError] {
        workspace_uri(self.uri)?;
        let fields = Vec::from_array(
            [("kind", json::Value::String("create")), ("uri", json::Value::String(self.uri))],
        );
        if let Some(options) = self.options {
            fields.push(("options", options.to_json()));
        }
        workspace_put_string(fields, "annotationId", self.annotation_id);
        Result::Ok(json::object(fields))
    }
}

pub struct RenameFile {
    pub old_uri: string,
    pub new_uri: string,
    pub options: Option[RenameFileOptions],
    pub annotation_id: Option[string],
}

impl RenameFile {
    pub fn from_json(value: json::Value) -> Result[RenameFile, RpcError] {
        let _ = members(value)?;
        if string_field(value, "kind")? != "rename" {
            return Result::Err(invalid("unexpected resource operation kind"))
        }
        let options = match json::field(value, "options") {
            Some(value) => Option::Some(RenameFileOptions::from_json(value)?),
            None => Option::None,
        };
        let result = RenameFile {
            old_uri: string_field(value, "oldUri")?,
            new_uri: string_field(value, "newUri")?,
            options,
            annotation_id: workspace_string(value, "annotationId")?,
        };
        let _ = result.to_json()?;
        Result::Ok(result)
    }

    pub fn to_json(self: RenameFile) -> Result[json::Value, RpcError] {
        workspace_uri(self.old_uri)?;
        workspace_uri(self.new_uri)?;
        let fields = Vec::from_array(
            [
                ("kind", json::Value::String("rename")),
                ("oldUri", json::Value::String(self.old_uri)),
                ("newUri", json::Value::String(self.new_uri)),
            ],
        );
        if let Some(options) = self.options {
            fields.push(("options", options.to_json()));
        }
        workspace_put_string(fields, "annotationId", self.annotation_id);
        Result::Ok(json::object(fields))
    }
}

