pub enum DocumentChange {
    Edit(TextDocumentEdit),
    Create(CreateFile),
    Rename(RenameFile),
    Delete(DeleteFile),
}

impl DocumentChange {
    pub fn from_json(value: json::Value) -> Result[DocumentChange, RpcError] {
        if let Some(kind) = json::field(value, "kind") {
            match kind {
                json::Value::String("create") => Result::Ok(
                    DocumentChange::Create(CreateFile::from_json(value)?),
                ),
                json::Value::String("rename") => Result::Ok(
                    DocumentChange::Rename(RenameFile::from_json(value)?),
                ),
                json::Value::String("delete") => Result::Ok(
                    DocumentChange::Delete(DeleteFile::from_json(value)?),
                ),
                _ => Result::Err(invalid("unknown resource operation kind")),
            }
        } else {
            Result::Ok(DocumentChange::Edit(TextDocumentEdit::from_json(value)?))
        }
    }

    pub fn to_json(self: DocumentChange) -> Result[json::Value, RpcError] {
        match self {
            Edit(edit) => edit.to_json(),
            Create(edit) => edit.to_json(),
            Rename(edit) => edit.to_json(),
            Delete(edit) => edit.to_json(),
        }
    }
}

#[derive(Debug, PartialEq, Eq)]
pub enum ResourceOperationKind {
    Create,
    Rename,
    Delete,
}

impl ResourceOperationKind {
    pub fn from_json(value: json::Value) -> Result[ResourceOperationKind, RpcError] {
        match value {
            json::Value::String("create") => Result::Ok(ResourceOperationKind::Create),
            json::Value::String("rename") => Result::Ok(ResourceOperationKind::Rename),
            json::Value::String("delete") => Result::Ok(ResourceOperationKind::Delete),
            _ => Result::Err(invalid("unknown resource operation capability")),
        }
    }

    pub fn to_json(self: ResourceOperationKind) -> json::Value {
        json::Value::String(
            match self {
                Create => "create",
                Rename => "rename",
                Delete => "delete",
            },
        )
    }
}

#[derive(Debug, PartialEq, Eq)]
pub enum FailureHandlingKind {
    Abort,
    Transactional,
    TextOnlyTransactional,
    Undo,
}

impl FailureHandlingKind {
    pub fn from_json(value: json::Value) -> Result[FailureHandlingKind, RpcError] {
        match value {
            json::Value::String("abort") => Result::Ok(FailureHandlingKind::Abort),
            json::Value::String("transactional") => Result::Ok(FailureHandlingKind::Transactional),
            json::Value::String("textOnlyTransactional") => Result::Ok(
                FailureHandlingKind::TextOnlyTransactional,
            ),
            json::Value::String("undo") => Result::Ok(FailureHandlingKind::Undo),
            _ => Result::Err(invalid("unknown workspace failure handling capability")),
        }
    }

    pub fn to_json(self: FailureHandlingKind) -> json::Value {
        json::Value::String(
            match self {
                Abort => "abort",
                Transactional => "transactional",
                TextOnlyTransactional => "textOnlyTransactional",
                Undo => "undo",
            },
        )
    }
}

pub struct ChangeAnnotationSupport {
    pub groups_on_label: Option[bool],
}

pub struct WorkspaceEditCapabilities {
    pub document_changes: Option[bool],
    pub resource_operations: Option[Vec[ResourceOperationKind]],
    pub failure_handling: Option[FailureHandlingKind],
    pub normalizes_line_endings: Option[bool],
    pub change_annotation_support: Option[ChangeAnnotationSupport],
}

impl WorkspaceEditCapabilities {
    pub fn new() -> WorkspaceEditCapabilities {
        WorkspaceEditCapabilities {
            document_changes: Option::None,
            resource_operations: Option::None,
            failure_handling: Option::None,
            normalizes_line_endings: Option::None,
            change_annotation_support: Option::None,
        }
    }

    pub fn from_json(value: json::Value) -> Result[WorkspaceEditCapabilities, RpcError] {
        let _ = members(value)?;
        let operations = match json::field(value, "resourceOperations") {
            None => Option::None,
            Some(value) => {
                let operations = Vec::new();
                for operation in json::as_array(value).ok_or(
                    invalid("resourceOperations must be an array"),
                )? {
                    operations.push(ResourceOperationKind::from_json(operation)?);
                }
                Option::Some(operations)
            },
        };
        let failure = match json::field(value, "failureHandling") {
            None => Option::None,
            Some(value) => Option::Some(FailureHandlingKind::from_json(value)?),
        };
        let annotations = match json::field(value, "changeAnnotationSupport") {
            None => Option::None,
            Some(value) => {
                let _ = members(value)?;
                Option::Some(
                    ChangeAnnotationSupport {
                        groups_on_label: workspace_bool(value, "groupsOnLabel")?,
                    },
                )
            },
        };
        Result::Ok(
            WorkspaceEditCapabilities {
                document_changes: workspace_bool(value, "documentChanges")?,
                resource_operations: operations,
                failure_handling: failure,
                normalizes_line_endings: workspace_bool(value, "normalizesLineEndings")?,
                change_annotation_support: annotations,
            },
        )
    }

    pub fn from_client_capabilities(value: json::Value) -> Result[
        WorkspaceEditCapabilities,
        RpcError,
    ] {
        let _ = members(value)?;
        let Some(workspace) = json::field(value, "workspace") else {
            return Result::Ok(WorkspaceEditCapabilities::new())
        };
        let _ = members(workspace)?;
        match json::field(workspace, "workspaceEdit") {
            None => Result::Ok(WorkspaceEditCapabilities::new()),
            Some(value) => WorkspaceEditCapabilities::from_json(value),
        }
    }

    pub fn to_json(self: WorkspaceEditCapabilities) -> json::Value {
        let fields = Vec::new();
        workspace_put_bool(fields, "documentChanges", self.document_changes);
        if let Some(operations) = self.resource_operations {
            let values = Vec::new();
            for operation in operations {
                values.push(operation.to_json());
            }
            fields.push(("resourceOperations", json::Value::Array(values)));
        }
        if let Some(failure) = self.failure_handling {
            fields.push(("failureHandling", failure.to_json()));
        }
        workspace_put_bool(fields, "normalizesLineEndings", self.normalizes_line_endings);
        if let Some(support) = self.change_annotation_support {
            let annotation_fields = Vec::new();
            workspace_put_bool(annotation_fields, "groupsOnLabel", support.groups_on_label);
            fields.push(("changeAnnotationSupport", json::object(annotation_fields)));
        }
        json::object(fields)
    }

    pub fn supports_resource(self: WorkspaceEditCapabilities, kind: ResourceOperationKind) -> bool {
        if let Some(operations) = self.resource_operations {
            for operation in operations {
                if operation == kind {
                    return true
                }
            }
        }
        false
    }
}

pub struct WorkspaceEdit {
    pub changes: Option[Vec[(string, Vec[TextEdit])]],
    pub document_changes: Option[Vec[DocumentChange]],
    pub change_annotations: Option[Vec[(string, ChangeAnnotation)]],
}

impl WorkspaceEdit {
    pub fn new() -> WorkspaceEdit {
        WorkspaceEdit {
            changes: Option::None,
            document_changes: Option::None,
            change_annotations: Option::None,
        }
    }

    pub fn from_json(value: json::Value) -> Result[WorkspaceEdit, RpcError] {
        let _ = members(value)?;
        let changes = match json::field(value, "changes") {
            None => Option::None,
            Some(value) => {
                let changes = Vec::new();
                for (uri, values) in members(value)? {
                    let edits = Vec::new();
                    for edit in json::as_array(values).ok_or(
                        invalid("changes entries must be arrays"),
                    )? {
                        if json::field(edit, "annotationId").is_some() {
                            return Result::Err(invalid("annotated edits require documentChanges"))
                        }
                        edits.push(TextEdit::from_json(edit)?);
                    }
                    changes.push((uri, edits));
                }
                Option::Some(changes)
            },
        };
        let documents = match json::field(value, "documentChanges") {
            None => Option::None,
            Some(value) => {
                let documents = Vec::new();
                for change in json::as_array(value).ok_or(
                    invalid("documentChanges must be an array"),
                )? {
                    documents.push(DocumentChange::from_json(change)?);
                }
                Option::Some(documents)
            },
        };
        let annotations = match json::field(value, "changeAnnotations") {
            None => Option::None,
            Some(value) => {
                let annotations = Vec::new();
                for (id, annotation) in members(value)? {
                    annotations.push((id, ChangeAnnotation::from_json(annotation)?));
                }
                Option::Some(annotations)
            },
        };
        let result = WorkspaceEdit {
            changes,
            document_changes: documents,
            change_annotations: annotations,
        };
        result.validate()?;
        Result::Ok(result)
    }

    pub fn validate(self: WorkspaceEdit) -> Result[(), RpcError] {
        let annotations: HashMap[string, bool] = HashMap::new();
        if let Some(values) = self.change_annotations {
            for (id, _) in values {
                if annotations.contains(id) {
                    return Result::Err(invalid("duplicate change annotation"))
                }
                annotations.set(id, true);
            }
        }
        if let Some(changes) = self.changes {
            let seen: HashMap[string, bool] = HashMap::new();
            for (uri, edits) in changes {
                workspace_uri(uri)?;
                if seen.contains(uri) {
                    return Result::Err(invalid("duplicate changes URI"))
                }
                seen.set(uri, true);
                workspace_ranges(edits)?;
            }
        }
        if let Some(changes) = self.document_changes {
            for change in changes {
                let annotation = match change {
                    Edit(edit) => {
                        edit.validate()?;
                        for item in edit.edits {
                            if let DocumentTextEdit::Annotated(item) = item {
                                workspace_annotation(Option::Some(item.annotation_id), annotations)?;
                            }
                        }
                        Option::None
                    },
                    Create(edit) => {
                        let _ = edit.to_json()?;
                        edit.annotation_id
                    },
                    Rename(edit) => {
                        let _ = edit.to_json()?;
                        edit.annotation_id
                    },
                    Delete(edit) => {
                        let _ = edit.to_json()?;
                        edit.annotation_id
                    },
                };
                workspace_annotation(annotation, annotations)?;
            }
        }
        Result::Ok(())
    }

    pub fn to_json(self: WorkspaceEdit) -> Result[json::Value, RpcError] {
        self.validate()?;
        let fields = Vec::new();
        if let Some(changes) = self.changes {
            let entries = Vec::new();
            for (uri, edits) in changes {
                let values = Vec::new();
                for edit in edits {
                    values.push(edit.to_json());
                }
                entries.push((uri, json::Value::Array(values)));
            }
            fields.push(("changes", json::object(entries)));
        }
        if let Some(changes) = self.document_changes {
            let values = Vec::new();
            for change in changes {
                values.push(change.to_json()?);
            }
            fields.push(("documentChanges", json::Value::Array(values)));
        }
        if let Some(annotations) = self.change_annotations {
            let values = Vec::new();
            for (id, annotation) in annotations {
                values.push((id, annotation.to_json()));
            }
            fields.push(("changeAnnotations", json::object(values)));
        }
        Result::Ok(json::object(fields))
    }

    pub fn for_client(self: WorkspaceEdit, capabilities: WorkspaceEditCapabilities) -> Result[
        WorkspaceEdit,
        RpcError,
    ] {
        self.validate()?;
        if let Some(annotations) = self.change_annotations {
            if annotations.len() > 0 && capabilities.change_annotation_support.is_none() {
                return Result::Err(invalid("client does not support change annotations"))
            }
        }
        let Some(changes) = self.document_changes else {
            return Result::Ok(self)
        };
        let versioned = capabilities.document_changes.unwrap_or(false);
        let resource_capable = capabilities.resource_operations.map(
            |operations| operations.len() > 0,
        ).unwrap_or(false);
        if versioned || resource_capable {
            for change in changes {
                let kind = match change {
                    Edit(edit) => {
                        if edit.version.is_some() && !versioned {
                            return Result::Err(invalid("client does not support document versions"))
                        }
                        Option::None
                    },
                    Create(_) => Option::Some(ResourceOperationKind::Create),
                    Rename(_) => Option::Some(ResourceOperationKind::Rename),
                    Delete(_) => Option::Some(ResourceOperationKind::Delete),
                };
                if let Some(kind) = kind {
                    if !capabilities.supports_resource(kind) {
                        return Result::Err(
                            invalid("client does not support this resource operation"),
                        )
                    }
                }
            }
            return Result::Ok(WorkspaceEdit { changes: Option::None, ..self })
        }
        let legacy = Vec::new();
        let seen: HashMap[string, bool] = HashMap::new();
        for change in changes {
            let DocumentChange::Edit(edit) = change else {
                return Result::Err(invalid("client does not support resource documentChanges"))
            };
            if edit.version.is_some() {
                return Result::Err(invalid("cannot discard document version for legacy client"))
            }
            if seen.contains(edit.uri) {
                return Result::Err(invalid("cannot merge sequential edits for legacy client"))
            }
            seen.set(edit.uri, true);
            let edits = Vec::new();
            for item in edit.edits {
                let DocumentTextEdit::Plain(item) = item else {
                    return Result::Err(invalid("cannot discard edit annotations for legacy client"))
                };
                edits.push(item);
            }
            legacy.push((edit.uri, edits));
        }
        if let Some(fallback) = self.changes {
            workspace_fallback(fallback, legacy)?;
        }
        Result::Ok(
            WorkspaceEdit { changes: Option::Some(legacy), document_changes: Option::None, ..self },
        )
    }

    pub fn to_json_for(self: WorkspaceEdit, capabilities: WorkspaceEditCapabilities) -> Result[
        json::Value,
        RpcError,
    ] {
        self.for_client(capabilities)?.to_json()
    }
}

fn workspace_annotation(id: Option[string], annotations: HashMap[string, bool]) -> Result[
    (),
    RpcError,
] {
    if let Some(id) = id {
        if !annotations.contains(id) {
            return Result::Err(invalid("unknown change annotation reference"))
        }
    }
    Result::Ok(())
}

pub struct ApplyWorkspaceEditParams {
    pub label: Option[string],
    pub edit: WorkspaceEdit,
}

impl ApplyWorkspaceEditParams {
    pub fn from_json(value: json::Value) -> Result[ApplyWorkspaceEditParams, RpcError] {
        let _ = members(value)?;
        Result::Ok(
            ApplyWorkspaceEditParams {
                label: workspace_string(value, "label")?,
                edit: WorkspaceEdit::from_json(required(value, "edit")?)?,
            },
        )
    }

    pub fn to_json(self: ApplyWorkspaceEditParams) -> Result[json::Value, RpcError] {
        let fields = Vec::from_array([("edit", self.edit.to_json()?)]);
        workspace_put_string(fields, "label", self.label);
        Result::Ok(json::object(fields))
    }

    pub fn to_json_for(self: ApplyWorkspaceEditParams, capabilities: WorkspaceEditCapabilities) -> Result[
        json::Value,
        RpcError,
    ] {
        ApplyWorkspaceEditParams { edit: self.edit.for_client(capabilities)?, ..self }.to_json()
    }
}

pub struct ApplyWorkspaceEditResult {
    pub applied: bool,
    pub failure_reason: Option[string],
    pub failed_change: Option[isize],
}

impl ApplyWorkspaceEditResult {
    pub fn from_json(value: json::Value) -> Result[ApplyWorkspaceEditResult, RpcError] {
        let _ = members(value)?;
        let applied = workspace_bool(value, "applied")?.ok_or(invalid("missing applied"))?;
        let failed_change = match json::field(value, "failedChange") {
            None => Option::None,
            Some(value) => Option::Some(unsigned(value)?),
        };
        Result::Ok(
            ApplyWorkspaceEditResult {
                applied,
                failure_reason: workspace_string(value, "failureReason")?,
                failed_change,
            },
        )
    }

    pub fn to_json(self: ApplyWorkspaceEditResult) -> Result[json::Value, RpcError] {
        let fields = Vec::from_array([("applied", json::Value::Bool(self.applied))]);
        workspace_put_string(fields, "failureReason", self.failure_reason);
        if let Some(index) = self.failed_change {
            let _ = unsigned(json::Value::Number(index.to_string()))?;
            fields.push(("failedChange", json::Value::Number(index.to_string())));
        }
        Result::Ok(json::object(fields))
    }
}

fn workspace_fallback(provided: Vec[(string, Vec[TextEdit])], derived: Vec[(string, Vec[TextEdit])]) -> Result[
    (),
    RpcError,
] {
    if provided.len() != derived.len() {
        return Result::Err(invalid("conflicting legacy fallback"))
    }
    let by_uri: HashMap[string, Vec[TextEdit]] = HashMap::new();
    for (uri, edits) in provided {
        by_uri.set(uri, edits);
    }
    for (uri, edits) in derived {
        let fallback = by_uri.get(uri).ok_or(invalid("conflicting legacy fallback"))?;
        if fallback.len() != edits.len() {
            return Result::Err(invalid("conflicting legacy fallback"))
        }
        for index in 0..edits.len() {
            if edits[index].range != fallback[index].range
                || edits[index].new_text != fallback[index].new_text {
                return Result::Err(invalid("conflicting legacy fallback"))
            }
        }
    }
    Result::Ok(())
}
