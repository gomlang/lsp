package lsp;

use std::json;

fn workspace_bool(value: json::Value, key: string) -> Result[Option[bool], RpcError] {
    match json::field(value, key) {
        None => Result::Ok(Option::None),
        Some(json::Value::Bool(flag)) => Result::Ok(Option::Some(flag)),
        _ => Result::Err(invalid(f"{key} must be a boolean")),
    }
}

fn workspace_string(value: json::Value, key: string) -> Result[Option[string], RpcError] {
    match json::field(value, key) {
        None => Result::Ok(Option::None),
        Some(json::Value::String(text)) => Result::Ok(Option::Some(text)),
        _ => Result::Err(invalid(f"{key} must be a string")),
    }
}

fn workspace_put_bool(fields: Vec[(string, json::Value)], key: string, flag: Option[bool]) -> () {
    if let Some(flag) = flag {
        fields.push((key, json::Value::Bool(flag)));
    }
}

fn workspace_put_string(fields: Vec[(string, json::Value)], key: string, value: Option[string]) -> () {
    if let Some(value) = value {
        fields.push((key, json::Value::String(value)));
    }
}

fn workspace_uri(uri: string) -> Result[(), RpcError] {
    if uri == "" {
        Result::Err(invalid("document URI must not be empty"))
    } else {
        Result::Ok(())
    }
}

fn workspace_ranges(edits: Vec[TextEdit]) -> Result[(), RpcError] {
    let ordered: Vec[(Range, isize)] = Vec::new();
    for index in 0..edits.len() {
        let range = Range::from_json(edits[index].range.to_json())?;
        ordered.push((range, index));
    }
    ordered.sort_by(
        |left, right| {
            if before(left.0.start, right.0.start) {
                -1
            } else if before(right.0.start, left.0.start) {
                1
            } else {
                left.1 - right.1
            }
        },
    );
    let mut previous = Option::None;
    for (range, _) in ordered {
        if let Some(end) = previous {
            if before(range.start, end) {
                return Result::Err(invalid("overlapping text edits"))
            }
        }
        previous = Option::Some(range.end);
    }
    Result::Ok(())
}

pub struct AnnotatedTextEdit {
    pub range: Range,
    pub new_text: string,
    pub annotation_id: string,
}

impl AnnotatedTextEdit {
    pub fn from_json(value: json::Value) -> Result[AnnotatedTextEdit, RpcError] {
        let edit = TextEdit::from_json(value)?;
        Result::Ok(
            AnnotatedTextEdit {
                range: edit.range,
                new_text: edit.new_text,
                annotation_id: string_field(value, "annotationId")?,
            },
        )
    }

    pub fn to_json(self: AnnotatedTextEdit) -> Result[json::Value, RpcError] {
        let _ = Range::from_json(self.range.to_json())?;
        Result::Ok(
            json::object(
                Vec::from_array(
                    [
                        ("range", self.range.to_json()),
                        ("newText", json::Value::String(self.new_text)),
                        ("annotationId", json::Value::String(self.annotation_id)),
                    ],
                ),
            ),
        )
    }
}

pub enum DocumentTextEdit {
    Plain(TextEdit),
    Annotated(AnnotatedTextEdit),
}

impl DocumentTextEdit {
    pub fn from_json(value: json::Value) -> Result[DocumentTextEdit, RpcError] {
        if json::field(value, "annotationId").is_some() {
            Result::Ok(DocumentTextEdit::Annotated(AnnotatedTextEdit::from_json(value)?))
        } else {
            Result::Ok(DocumentTextEdit::Plain(TextEdit::from_json(value)?))
        }
    }

    pub fn to_json(self: DocumentTextEdit) -> Result[json::Value, RpcError] {
        match self {
            Plain(edit) => {
                let _ = Range::from_json(edit.range.to_json())?;
                Result::Ok(edit.to_json())
            },
            Annotated(edit) => edit.to_json(),
        }
    }

    pub fn text_edit(self: DocumentTextEdit) -> TextEdit {
        match self {
            Plain(edit) => edit,
            Annotated(edit) => TextEdit { range: edit.range, new_text: edit.new_text },
        }
    }
}

pub struct TextDocumentEdit {
    pub uri: string,
    pub version: Option[isize],
    pub edits: Vec[DocumentTextEdit],
}

impl TextDocumentEdit {
    pub fn from_json(value: json::Value) -> Result[TextDocumentEdit, RpcError] {
        let _ = members(value)?;
        let document = required(value, "textDocument")?;
        let _ = members(document)?;
        let version = match required(document, "version")? {
            json::Value::Null => Option::None,
            value => Option::Some(integer(value)?),
        };
        let edits = Vec::new();
        for edit in json::as_array(required(value, "edits")?).ok_or(
            invalid("edits must be an array"),
        )? {
            edits.push(DocumentTextEdit::from_json(edit)?);
        }
        let result = TextDocumentEdit { uri: string_field(document, "uri")?, version, edits };
        result.validate()?;
        Result::Ok(result)
    }

    pub fn validate(self: TextDocumentEdit) -> Result[(), RpcError] {
        workspace_uri(self.uri)?;
        if let Some(version) = self.version {
            let _ = integer(json::Value::Number(version.to_string()))?;
        }
        let edits = Vec::new();
        for edit in self.edits {
            edits.push(edit.text_edit());
        }
        workspace_ranges(edits)
    }

    pub fn validate_document(self: TextDocumentEdit, document: Document) -> Result[(), RpcError] {
        self.validate()?;
        if self.uri != document.uri() {
            return Result::Err(invalid("edit URI does not match document"))
        }
        if let Some(version) = self.version {
            if version != document.version() {
                return Result::Err(invalid("edit version does not match document"))
            }
        }
        let spans: Vec[(isize, isize, isize)] = Vec::new();
        for index in 0..self.edits.len() {
            let (start, end) = document.offsets(self.edits[index].text_edit().range)?;
            spans.push((start, end, index));
        }
        spans.sort_by(
            |left, right| if left.0 == right.0 {
                left.2 - right.2
            } else {
                left.0 - right.0
            },
        );
        let mut cursor = 0;
        for (start, end, _) in spans {
            if start < cursor {
                return Result::Err(invalid("overlapping text edits after position clamping"))
            }
            cursor = end;
        }
        Result::Ok(())
    }

    pub fn to_json(self: TextDocumentEdit) -> Result[json::Value, RpcError] {
        self.validate()?;
        let edits = Vec::new();
        for edit in self.edits {
            edits.push(edit.to_json()?);
        }
        Result::Ok(
            json::object(
                Vec::from_array(
                    [
                        (
                            "textDocument",
                            json::object(
                                Vec::from_array(
                                    [
                                        ("uri", json::Value::String(self.uri)),
                                        (
                                            "version",
                                            self.version.map(
                                                |version| json::Value::Number(version.to_string()),
                                            ).unwrap_or(json::Value::Null),
                                        ),
                                    ],
                                ),
                            ),
                        ),
                        ("edits", json::Value::Array(edits)),
                    ],
                ),
            ),
        )
    }
}

pub struct ChangeAnnotation {
    pub label: string,
    pub needs_confirmation: Option[bool],
    pub description: Option[string],
}

impl ChangeAnnotation {
    pub fn from_json(value: json::Value) -> Result[ChangeAnnotation, RpcError] {
        let _ = members(value)?;
        Result::Ok(
            ChangeAnnotation {
                label: string_field(value, "label")?,
                needs_confirmation: workspace_bool(value, "needsConfirmation")?,
                description: workspace_string(value, "description")?,
            },
        )
    }

    pub fn to_json(self: ChangeAnnotation) -> json::Value {
        let fields = Vec::from_array([("label", json::Value::String(self.label))]);
        workspace_put_bool(fields, "needsConfirmation", self.needs_confirmation);
        workspace_put_string(fields, "description", self.description);
        json::object(fields)
    }
}

