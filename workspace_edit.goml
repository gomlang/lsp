    pub fn to_json(self: CreateFileOptions) -> json::Value {
        let fields = Vec::new();
        workspace_put_bool(fields, "overwrite", self.overwrite);
        workspace_put_bool(fields, "ignoreIfExists", self.ignore_if_exists);
        json::object(fields)
    }
}

