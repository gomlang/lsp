package tests;

use ecosystem::lsp;
use std::testing;

#[test]
fn original_coordinate_edits_check_final_size_before_materialization() -> () {
    let document = testing::expect_ok(
        lsp::Document::new("file:///a", "goml", 1, "A😀BC"),
        "document",
    );
    let edits = Vec::from_array(
        [
            lsp::TextEdit { range: range(0, 0, 0), new_text: "long" },
            lsp::TextEdit { range: range(0, 0, 3), new_text: "" },
        ],
    );
    testing::assert_eq(
        testing::expect_ok(document.apply_edits_with_limit(edits, 6), "balanced edit"),
        "longBC",
    );
    testing::assert_err(document.apply_edits_with_limit(edits, 5));
    testing::assert_err(document.apply_edits_with_limit(Vec::new(), 6));
    testing::assert_err(document.apply_edits_with_limit(Vec::new(), -1));
    testing::assert_eq(
        testing::expect_ok(
            document.apply_edits_with_limit(
                Vec::from_array([lsp::TextEdit { range: range(0, 0, 5), new_text: "" }]),
                0,
            ),
            "delete all",
        ),
        "",
    );
    testing::assert_eq(document.content(), "A😀BC");
    testing::assert_eq(document.version(), 1);
    let insertions = Vec::from_array(
        [
            lsp::TextEdit { range: range(0, 3, 3), new_text: "x" },
            lsp::TextEdit { range: range(0, 3, 3), new_text: "y" },
        ],
    );
    testing::assert_eq(
        testing::expect_ok(document.apply_edits_with_limit(insertions, 9), "stable inserts"),
        "A😀xyBC",
    );
}

#[test]
fn range_and_overlap_errors_win_before_output_budget_failures() -> () {
    let document = testing::expect_ok(
        lsp::Document::new("file:///a", "goml", 1, "A😀BC"),
        "document",
    );
    let bad = Vec::from_array(
        [
            lsp::TextEdit { range: range(0, 0, 0), new_text: "x".repeat(1000) },
            lsp::TextEdit { range: range(0, 2, 3), new_text: "" },
        ],
    );
    let problem = testing::expect_err(document.apply_edits_with_limit(bad, 0), "UTF-16 boundary");
    testing::assert(problem.message.contains("surrogate"));
    let overlaps = Vec::from_array(
        [
            lsp::TextEdit { range: range(0, 0, 3), new_text: "x".repeat(1000) },
            lsp::TextEdit { range: range(0, 1, 3), new_text: "" },
        ],
    );
    testing::assert(
        testing::expect_err(document.apply_edits_with_limit(overlaps, 0), "overlap").message.contains(
            "overlapping",
        ),
    );
}
